Function GetModelLength_Axial
  boundaries = Array()
  boundaries = oEditor.GetModelBoundingBox
  if CDbl("1,000") = 1.000 then
  GetModelLength_Axial = (CDbl(Replace(boundaries(5), ".", ",")) - CDbl(Replace(boundaries(2), ".", ","))) * 1.05
  else
  GetModelLength_Axial = (CDbl(boundaries(5)) - CDbl(boundaries(2))) * 1.05
  end if
End Function

Function GetModelAxial_Center
  boundaries = Array()
  boundaries = oEditor.GetModelBoundingBox
  if CDbl("1,000") = 1.000 then
  GetModelAxial_Center = CDbl(Replace(Abs(boundaries(5)), ".", ",")) - CDbl(Replace(Abs(boundaries(2)), ".", ","))
  else
  GetModelAxial_Center = CDbl(Abs(boundaries(5))) - CDbl(Abs(boundaries(2)))
  end if
End Function

Sub CreateMagnetCoordinateSystem(magnetName, origin_X, origin_Y, origin_Z, vector_XX, vector_XY, vector_YX, vector_YY, ModelType)
  oEditor.SetWCS Array("NAME:SetWCS Parameter", "Working Coordinate System:=", "Global")
  oEditor.CreateRelativeCS Array("NAME:RelativeCSParameters", _
    "Mode:=", "Axis/Position", _
    "OriginX:=", Replace(CStr(origin_X), ",", ".") + "mm", _
    "OriginY:=", Replace(CStr(origin_Y), ",", ".") + "mm", _
    "OriginZ:=", Replace(CStr(origin_Z), ",", ".") + "mm", _
    "XAxisXvec:=", Replace(CStr(vector_XX), ",", ".") + "mm", _
    "XAxisYvec:=", Replace(CStr(vector_XY), ",", ".") + "mm", _
    "XAxisZvec:=", "0mm", _
    "YAxisXvec:=", Replace(CStr(vector_YX), ",", ".") + "mm", _
    "YAxisYvec:=", Replace(CStr(vector_YY), ",", ".") + "mm", _
    "YAxisZvec:=", "0mm"), _
    Array("NAME:Attributes", "Name:=", "CS_" + CStr(magnetName))

  oEditor.ChangeProperty Array("NAME:AllTabs", _
    Array("NAME:Geometry3DAttributeTab", _
      Array("NAME:PropServers", CStr(magnetName)), _
      Array("NAME:ChangedProps", _
        Array("NAME:Orientation", "Value:=", "CS_" + CStr(magnetName)))))

  If ModelType = 0 Then
    ' Assign excitation to magnets for magnet eddy current loss calculations
    oBoundaryModule.AssignCurrent Array("NAME:" + CStr(magnetName), _
      "Objects:=", Array(CStr(magnetName)), _
        "Current:=", "0A" , _
        "IsPositive:=", true)
  End If
End Sub

