' Ansys script methods
Sub ChangePropertyName(name, name_New)
  oEditor.ChangeProperty Array("NAME:AllTabs", _
    Array("NAME:Geometry3DAttributeTab", _
    Array("NAME:PropServers", CStr(name)), _
    Array("NAME:ChangedProps", _
    Array("NAME:Name", "Value:=", CStr(name_New)))))
End Sub

Sub SubtractObjects(blankPartList, toolPartList, keepOriginals)
' Subtract tool parts boundaries from blank part boundaries
  oEditor.Subtract Array("NAME:Selections", _
    "Blank Parts:=", CStr(blankPartList), _
    "Tool Parts:=", CStr(toolPartList)), _
    Array("NAME:SubtractParameters", "KeepOriginals:=", keepOriginals)
End Sub

Sub CreateOutputVariable(variableName, Expression)
  oOutputVarModule.CreateOutputVariable CStr(variableName),  _
  CStr(Expression),  _
  "Setup1 : Transient", "Transient", Array()
End Sub

Sub BandToolSubtraction(bandTool)
  dim numObjects
  dim objectString
  dim name
  numObjects = oEditor.GetNumObjects()
  for objectLoop = 0 to (numObjects - 1)
    name = oEditor.GetObjectName(CInt(objectLoop))
      If bandTool <> CStr(name) then
        objectSring = objectSring + CStr(name) + ","
      End If
  Next

oEditor.Subtract Array("NAME:Selections", _
  "Blank Parts:=", CStr(objectSring), _
  "Tool Parts:=", CStr(bandTool)), _
  Array("NAME:SubtractParameters", "KeepOriginals:=",  false)  
End Sub

Sub rotateObject(name, skewAngle)
  oEditor.Rotate Array("NAME:Selections", _
	  "Selections:=", CStr(name), _
    "NewPartsModelFlag:=", "Model"), _
	  Array("NAME:RotateParameters", _
    "RotateAxis:=", "Z", _
    "RotateAngle:=", Replace(CStr(skewAngle), ",", ".") + "deg")
End Sub

Sub splitObject(name, side)
  oEditor.Split Array("NAME:Selections", _
    "Selections:=", CStr(name), _
    "NewPartsModelFlag:=", "Model"), _
    Array("Name:SplitToParameters", _
    "SplitPlane:=", "ZX", _
    "WhichSide:=", CStr(side), _
    "ToolType:=", "PlaneTool", _
    "ToolEntityID:=", -1, _
    "SplitCrossingObjectsOnly:=", false, _
    "DeleteInvalidObjects:=", true)
End Sub

Sub createRectangleObject(name, Xstart, Ystart, Zstart, Width, Height, Axis)
  oEditor.CreateRectangle Array("NAME:RectangleParameters", _
    "IsCovered:=", true, _
    "XStart:=", CStr(Xstart), _
    "YStart:=", CStr(Ystart), _
    "ZStart:=", CStr(Zstart), _
    "Width:=", CStr(Width), _
    "Height:=", CStr(Height), _
    "WhichAxis:=", CStr(Axis)), _
    Array("NAME:Attributes", _
    "Name:=", CStr(name), _
    "Flags:=", "", _
    "Color:=", "(143 175 143)", _
    "Transparency:=", 0, _
    "PartCoordinateSystem:=", "Global", _
    "UDMId:=", "", _
    "MaterialValue:=", "", _
    "SurfaceMaterialValue:=", "", _
    "SolveInside:=", true, _
    "ShellElement:=", false, _
    "ShellElementThicknesS:=", "0mm", _
    "ReferenceTemperature:=", "20cel", _
    "IsMaterialEditable:=", true, _
    "UseMaterialAppearance:=", false, _
    "IsLightweight:=", false)
End Sub

Sub extrudeMoveObject(Name, TranslateVectorZ, SweepVectorZ)
oEditor.Move Array("NAME:Selections", _
    "Selections:=", CStr(Name), _
    "NewPartsModelFlag:=", "Model"), _ 
    Array("NAME:TranslateParameters", _
      "TranslateVectorX:=", "0mm", _
      "TranslateVectorY:=", "0mm", _
      "TranslateVectorZ:=", Replace(CStr(TranslateVectorZ), ",", "."))

  oEditor.SweepAlongVector Array("NAME:Selections", _
    "Selections:=", CStr(Name), _
    "NewPartsModelFlag:=", "Model"), _ 
    Array("NAME:VectorSweepParameters", _
      "DraftAngle:=", "0deg", _
      "DraftType:=", "Round", _
      "CheckFaceFaceIntersection:=", false, _
      "SweepVectorX:=",  "0mm", _
      "SweepVectorY:=", "0mm", _
      "SweepVectorZ:=", Replace(CStr(SweepVectorZ), ",", "."))
End Sub

Sub duplicateObject(nameCopy, nameNew, ZPosition)
  DuplicatedName = Array()
  DuplicatedName =	oEditor.DuplicateAlongLine(Array("NAME:Selections", _
                    "Selections:=", CStr(nameCopy), _
                    "NewPartsModelFlag:=", "Model"), _
	                  Array("NAME:DuplicateToAlongLineParameters", _
	                    "CreateNewObjects:=", true, _
	                    "XComponent:=", "0mm", _
	                    "YComponent:=", "0mm", _
	                    "ZComponent:=", "-" + Replace(CStr(ZPosition), ",", ".") + "mm", _
	                    "NumClones:=", "2"), _
	                  Array("NAME:Options", "DuplicateAssignments:=", false), _
	                  Array("CreateGroupsForNewObjects:=", false))
  Call changePropertyName(DuplicatedName(0), nameNew)
End Sub

Sub moveObject(name, TranslateVectorZ)
oEditor.Move Array("NAME:Selections", _
    "Selections:=", CStr(Name), _
    "NewPartsModelFlag:=", "Model"), _ 
    Array("NAME:TranslateParameters", _
      "TranslateVectorX:=", "0mm", _
      "TranslateVectorY:=", "0mm", _
      "TranslateVectorZ:=", Replace(CStr(TranslateVectorZ), ",", ".") + "mm")
End Sub

Sub extrudeSkewObject(name, sweep, skewAngle)
  oEditor.SweepAlongVector Array("NAME:Selections", _
    "Selections:=", CStr(name), _
    "NewPartsModelFlag:=", "Model"), _ 
    Array("NAME:VectorSweepParameters", _
      "DraftAngle:=", "0deg", _
      "DraftType:=", "Round", _
      "CheckFaceFaceIntersection:=", false, _
      "SweepVectorX:=",  "0mm", _
      "SweepVectorY:=", "0mm", _
      "SweepVectorZ:=", "-" + Replace(CStr(sweep), ",", ".") + "mm")

If CDbl(skewAngle) <> 0 then
  Call rotateObject(name, skewAngle)
End If
End Sub

Sub applyInsulationToFace(magnetName, zCoord)
  'Apply insulation to bottom face of magnetName
  oFaceIDs = Array()
  oFaceIDs = oEditor.GetFaceIDs(CStr(magnetName))
  for faceLoop = 0 to UBound(oFaceIDs)
    oApplyInsulation = True
    oVertexIDs = Array()
    oVertexIDs = oEditor.GetVertexIDsFromFace(CLng(oFaceIDs(faceLoop)))

    for vertexLoop = 1 to UBound(oVertexIDs)
      vertex = Array()
      vertex = oEditor.GetVertexPosition(oVertexIDs(vertexLoop))

      if Round(CDbl(vertex(2)), 4) <> Round(CDbl(zCoord), 4) then
        oApplyInsulation = False
        Exit For
      End If
    Next

    if oApplyInsulation = True then
      oBoundaryModule.AssignInsulating Array("NAME:Insulation_" + CStr(magnetName), "Faces:=", Array(CLng(oFaceIDs(faceLoop))))
    End If
  Next
End Sub

Sub CreateWindingTerminal(coilName, terminalName, terminalType)
  oEditor.Copy Array("NAME:Selections", "Selections:=", CStr(coilName))
  pasteNames = Array()
  pasteNames = oEditor.Paste
  Call ChangePropertyName(pasteNames(0), terminalName)

  oEditor.ChangeProperty Array("NAME:AllTabs", _
    Array("NAME:Geometry3DCmdTab", _
    Array("NAME:PropServers", _
    CStr(terminalName) + ":CreateUserDefinedPart:1"), _
    Array("NAME:ChangedProps", _
    Array("NAME:Coordinate System", _
